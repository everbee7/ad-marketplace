# Canonical env var list. Validated at boot by src/env.ts.
# Local: copy to .env.local or run `vercel env pull .env.local`. Never commit real values.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth (Better Auth)
BETTER_AUTH_SECRET=            # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=flashd_dev

# Mux
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=       # base64-encoded

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Flashd <no-reply@example.com>"

# Rate limiting (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=             # build-time only (source maps)

# Cron
CRON_SECRET=

# Seed (scripts/seed-admin.ts)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
