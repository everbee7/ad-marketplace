# Canonical env var list. Validated at boot by src/env.ts (ADR-0005: Vercel + MongoDB only).
# Local: copy to .env.local. The defaults below run with ZERO external accounts.
# Deployed: set in Vercel project settings per environment (BLOB_READ_WRITE_TOKEN is added
# automatically when a Blob store is connected). Never commit real values.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth (Better Auth)
BETTER_AUTH_SECRET=                      # node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_URL=http://localhost:3000

# MongoDB. Local: `npm run db:local` (no install needed). Deployed: Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=flashd_dev

# File storage: local (dev only, writes .data/uploads) | blob (Vercel Blob)
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=                   # required when STORAGE_DRIVER=blob

# Email: console (prints emails/links to the terminal) | smtp
EMAIL_TRANSPORT=console
EMAIL_FROM="Flashd <no-reply@example.com>"
SMTP_HOST=                               # required when EMAIL_TRANSPORT=smtp
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Cron (Vercel sends it as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# Seed (scripts/seed-admin.ts)
SEED_ADMIN_EMAIL=admin@flashd.local
SEED_ADMIN_PASSWORD=
